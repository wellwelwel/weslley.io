{
  "name": "weslley-io",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wellwelwel"
  },
  "scripts": {
    "prestart": "bun tools/host.ts",
    "start": "bun run i18n:sync && bun run --parallel start:website start:server",
    "start:website": "bun --bun docusaurus start --host 0.0.0.0",
    "start:server": "bun wrangler dev --ip 0.0.0.0",
    "prebuild": "bun run i18n:sync",
    "build": "bun --bun docusaurus build",
    "build:server": "bun tools/build-worker.ts",
    "swizzle": "bun --bun docusaurus swizzle",
    "clear": "bun --bun docusaurus clear",
    "reset": "(bun run clear || true) && rm -rf node_modules bun.lock && bun install && bun run update",
    "i18n:sync": "bun tools/sync-i18n-articles.ts",
    "prepreview": "bun tools/host.ts",
    "serve": "bun run build && bun --bun docusaurus serve --host 0.0.0.0",
    "preview": "bun run --parallel serve start:server",
    "write-translations": "bun --bun docusaurus write-translations",
    "write-heading-ids": "bun --bun docusaurus write-heading-ids",
    "images:scan": "bun tools/images.ts scan",
    "images:build": "bun tools/images.ts build",
    "images:verify": "bun tools/images.ts verify",
    "typecheck": "bun --bun tsc",
    "lint": "bun --bun prettier --check .",
    "lint:fix": "bun --bun prettier --write .",
    "update": "bun --bun pu && bun install && (bun audit fix || true) && bun update && bun run lint:fix",
    "purge": "bun tools/purge-cache.ts",
    "test": "bun --bun poku -r=compact ./test",
    "test:ci": "bun run clear && bun run lint && bun run typecheck && bun run test && bun run build:server && bun run build",
    "countty:secret": "bun wrangler secret put COUNTTY_TOKEN",
    "countty:create": "bun --bun countty create",
    "countty:views": "bun --bun countty views",
    "countty:peek": "bun --bun countty peek",
    "countty:backup": "bun --bun countty backup",
    "countty:list": "bun --bun countty list",
    "countty:remove": "bun --bun countty remove"
  },
  "dependencies": {
    "countty": "^2.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@gsap/react": "^2.1.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webpack-env": "^1.18.8",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "devicon": "^2.17.0",
    "github-slugger": "^2.0.0",
    "gsap": "^3.15.0",
    "jsonc.min": "^1.1.2",
    "lucide-react": "^1.33.0",
    "packages-update": "^2.0.0",
    "playwright": "^1.62.1",
    "poku": "^4.5.0",
    "prettier": "^3.9.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-parallax-tilt": "^1.7.338",
    "remove-markdown": "^0.6.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0",
    "yaml.min": "^1.0.0"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "bun": ">=1.4"
  },
  "private": true
}
